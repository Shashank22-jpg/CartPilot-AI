# ==============================================================================
# CartPilot AI - Unified Vercel & Production Environment Variables Reference
# ==============================================================================
# In Vercel Project Settings -> Environment Variables, add the following variables:
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVERLESS API ENVIRONMENT (Secure Secrets)
# ------------------------------------------------------------------------------
# Runtime environment
NODE_ENV=production

# Server configuration (optional in Vercel serverless, defaults to 5000 in local dev)
PORT=5000
CLIENT_URL=https://your-cartpilot-app.vercel.app

# PayPal REST API v2 Sandbox Credentials (STRICT: LIVE MODE IS BLOCKED)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Supabase PostgreSQL & Authentication
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Gemini API
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# ------------------------------------------------------------------------------
# 2. FRONTEND VITE ENVIRONMENT (Public Browser Configuration)
# ------------------------------------------------------------------------------
# Relative API URL: Leave empty so client calls /api on the same Vercel domain
VITE_API_BASE_URL=

# Public Supabase credentials for client-side Auth with RLS
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Public PayPal Sandbox Client ID for SDK button rendering
VITE_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
VITE_APP_ENV=production
