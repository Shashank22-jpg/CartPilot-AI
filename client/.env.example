# CartPilot AI Frontend Environment Configuration
# Note: ONLY variables prefixed with VITE_ are exposed to the browser.
# NEVER place secret keys, service tokens, or private credentials here.

# Backend API URL (leave empty in local dev to use Vite reverse proxy, or set full URL for production)
VITE_API_BASE_URL=

# PayPal Sandbox Public Client ID (Public client ID only, NEVER client secret)
VITE_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here

# Supabase Project Credentials (safe for browser client with RLS enabled)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# App Environment
VITE_APP_ENV=development
